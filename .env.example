# ============================================================
# 碳资产助手 — 环境变量模板
#
# 使用方法：
#   cp .env.example .env
#   编辑 .env 填入实际值
# ============================================================

# ----------------------------------------------------------
# API 安全
# ----------------------------------------------------------
# API Key（FastAPI 鉴权用，生产环境必须设置）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 注意：留空或填占位值（your-api-key-here 等）时服务不鉴权，
# POST /api/kb/ingest-all 等写接口对任何访问者开放；可用 GET /api/health 的 security 字段自检。
APP_API_KEY=

# CORS 允许的来源（逗号分隔）
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# ----------------------------------------------------------
# LLM API（可选，用于政策问答功能）
# ----------------------------------------------------------
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENAI_API_KEY=

# LLM 模型选择
LLM_MODEL=deepseek-chat

# Embedding 模型（v0.4）：
#   auto（推荐，默认）= 已安装 fastembed 时用中文 fastembed:BAAI/bge-small-zh-v1.5，否则降级
#   chromadb-default  = 英文 all-MiniLM-L6-v2（中文效果差，仅作对照）
#   openai:text-embedding-3-small / sentence-transformers:<model>
EMBEDDING_MODEL=auto

# 检索模式：rrf3（默认，BM25+向量+字面规则 三路融合）/ rrf / rerank / hybrid / bm25 / vector / keyword
RETRIEVAL_MODE=rrf3

# 可选：交叉编码器精排（CPU 较慢，约 1GB 模型）。留空关闭
RERANKER_MODEL=

# 首次启动时知识库为空则自动入库
KB_AUTO_INGEST=1

# 国内网络下载模型慢时启用镜像
# HF_ENDPOINT=https://hf-mirror.com

# ----------------------------------------------------------
# Docker 部署
# ----------------------------------------------------------
# API 服务地址（Streamlit 调用 FastAPI 时使用）
API_BASE_URL=http://localhost:8000

# ----------------------------------------------------------
# 日志级别
# ----------------------------------------------------------
LOG_LEVEL=INFO
